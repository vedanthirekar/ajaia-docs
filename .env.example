# Postgres connection string (Neon pooled URL in production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: only needed if the app is served behind an unusual host/proxy
# AUTH_URL=http://localhost:3000
